    <IsTestProject>true</IsTestProject>
    <RootNamespace>Odex.AspNetCore.Caching.Redis.Tests</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
